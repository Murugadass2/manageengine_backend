datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  name          String
  role          String    @default("EMPLOYEE") // SUPER_ADMIN, HOTEL_MANAGER, DEPT_MANAGER, TECHNICIAN, EMPLOYEE
  employeeCode  String    @unique
  phone         String?
  avatarUrl     String?
  status        String    @default("ACTIVE") // ACTIVE, INACTIVE, ON_LEAVE
  departmentId  String?
  department    Department? @relation("DeptUsers", fields: [departmentId], references: [id])
  
  // Relations
  managedDepartment Department? @relation("DeptManager")
  requestedTickets   Ticket[]    @relation("RequestedTickets")
  assignedTickets    Ticket[]    @relation("AssignedTickets")
  comments           TicketComment[]
  workLogs           TicketWorkLog[]
  historyActions     TicketHistory[]
  assignedAssets     Asset[]
  requestedApprovals Approval[]  @relation("RequestedApprovals")
  assignedApprovals  Approval[]  @relation("AssignedApprovals")
  notifications      Notification[]
  auditLogs          AuditLog[]
  authoredArticles   KnowledgeArticle[]
  maintenanceTasks   MaintenanceSchedule[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Department {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String   @unique
  description String?
  status      String   @default("ACTIVE") // ACTIVE, DISABLED
  
  managerId   String?  @unique
  manager     User?    @relation("DeptManager", fields: [managerId], references: [id])
  
  users       User[]   @relation("DeptUsers")
  tickets     Ticket[]
  assets      Asset[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Ticket {
  id                   String        @id @default(uuid())
  ticketNumber         String        @unique // e.g. HD-2026-000123
  subject              String
  description          String        @db.Text
  type                 String        @default("SERVICE_REQUEST") // INCIDENT, SERVICE_REQUEST, MAINTENANCE_REQUEST, IT_SUPPORT, COMPLAINT, GENERAL_REQUEST
  priority             String        @default("MEDIUM") // CRITICAL, HIGH, MEDIUM, LOW
  impact               String        @default("MEDIUM") // HIGH, MEDIUM, LOW
  urgency              String        @default("MEDIUM") // HIGH, MEDIUM, LOW
  status               String        @default("NEW") // NEW, OPEN, ASSIGNED, ACCEPTED, IN_PROGRESS, PENDING_EMPLOYEE, PENDING_APPROVAL, ON_HOLD, RESOLVED, CLOSED, REOPENED, CANCELLED
  location             String?       // e.g. "Room 205", "Floor 2", "Kitchen Main", "Lobby Reception"
  
  // SLA tracking
  responseDueAt        DateTime
  resolutionDueAt      DateTime
  firstRespondedAt     DateTime?
  resolvedAt           DateTime?
  closedAt             DateTime?
  isEscalated          Boolean       @default(false)
  escalationReason     String?       @db.Text
  
  // Requester & Assignee
  requesterId          String
  requester            User          @relation("RequestedTickets", fields: [requesterId], references: [id])
  
  departmentId         String
  department           Department    @relation(fields: [departmentId], references: [id])
  
  assignedTechnicianId String?
  assignedTechnician   User?         @relation("AssignedTickets", fields: [assignedTechnicianId], references: [id])
  
  // Asset link
  assetId              String?
  asset                Asset?        @relation(fields: [assetId], references: [id])
  
  // Resolution & Feedback
  resolutionNotes      String?       @db.Text
  rejectionReason      String?       @db.Text
  satisfactionRating   Int?          // 1 to 5 stars
  feedback             String?       @db.Text

  comments             TicketComment[]
  workLogs             TicketWorkLog[]
  history              TicketHistory[]
  attachments          TicketAttachment[]
  approvals            Approval[]

  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
}

model TicketComment {
  id         String   @id @default(uuid())
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  content    String   @db.Text
  isInternal Boolean  @default(false) // Internal technician note vs public comment
  createdAt  DateTime @default(now())
}

model TicketWorkLog {
  id           String   @id @default(uuid())
  ticketId     String
  ticket       Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  technicianId String
  technician   User     @relation(fields: [technicianId], references: [id])
  hoursSpent   Float
  description  String   @db.Text
  createdAt    DateTime @default(now())
}

model TicketHistory {
  id           String   @id @default(uuid())
  ticketId     String
  ticket       Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actorId      String?
  actor        User?    @relation(fields: [actorId], references: [id])
  action       String   // STATUS_CHANGE, ASSIGNMENT, PRIORITY_CHANGE, COMMENT_ADDED, ESCALATED, RESOLVED
  fieldChanged String?
  oldValue     String?  @db.Text
  newValue     String?  @db.Text
  details      String?  @db.Text
  createdAt    DateTime @default(now())
}

model TicketAttachment {
  id         String   @id @default(uuid())
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  fileName   String
  fileUrl    String
  fileSize   Int
  fileType   String
  createdAt  DateTime @default(now())
}

model SLAPolicy {
  id                String   @id @default(uuid())
  name              String
  priority          String   @unique // CRITICAL, HIGH, MEDIUM, LOW
  responseMinutes   Int      // e.g. 15, 30, 120, 240
  resolutionMinutes Int      // e.g. 120, 240, 720, 1440
  escalationRole    String   @default("HOTEL_MANAGER")
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Asset {
  id             String       @id @default(uuid())
  assetTag       String       @unique // e.g. AS-001
  name           String       // e.g. Dell Latitude 5420, HP LaserJet Pro 400
  category       String       // COMPUTERS, PRINTERS, NETWORK, SERVERS, HVAC, POS, AV, ELEVATOR
  serialNumber   String?      @unique
  location       String?      // e.g. "Room 205", "Server Room 1", "Front Desk"
  status         String       @default("ACTIVE") // ACTIVE, UNDER_MAINTENANCE, RETIRED, IN_STORAGE
  cost           Float?
  purchaseDate   DateTime?
  warrantyExpiry DateTime?
  
  departmentId   String?
  department     Department?  @relation(fields: [departmentId], references: [id])
  
  assignedUserId String?
  assignedUser   User?        @relation(fields: [assignedUserId], references: [id])
  
  tickets        Ticket[]

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model InventoryItem {
  id            String                 @id @default(uuid())
  itemCode      String                 @unique // e.g. INV-1001
  name          String                 // e.g. Network Cable Cat6 5m, Printer Toner HP 85A
  category      String                 // IT, HOUSEKEEPING, ELECTRICAL, PLUMBING, HVAC
  stockQuantity Int                    @default(0)
  minLevel      Int                    @default(10)
  unit          String                 @default("pcs")
  unitPrice     Float                  @default(0.0)
  location      String?
  supplier      String?
  status        String                 @default("IN_STOCK") // IN_STOCK, LOW_STOCK, OUT_OF_STOCK

  transactions  InventoryTransaction[]

  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
}

model InventoryTransaction {
  id                String        @id @default(uuid())
  itemId            String
  item              InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type              String        // STOCK_IN, STOCK_OUT, ADJUSTMENT
  quantity          Int
  previousStock     Int
  newStock          Int
  referenceTicketId String?
  performedById     String?
  notes             String?
  createdAt         DateTime      @default(now())
}

model MaintenanceSchedule {
  id                   String    @id @default(uuid())
  equipmentName        String    // e.g. "AC Units Floor 2", "Diesel Generator 500kVA", "Elevator Passenger 1"
  category             String    // HVAC, ELECTRICAL, ELEVATOR, PLUMBING, KITCHEN
  location             String    // e.g. "Roof Deck", "Basement B2", "All Floors"
  frequency            String    // WEEKLY, MONTHLY, QUARTERLY, BI_ANNUAL, ANNUAL
  nextScheduledDate    DateTime
  lastCompletedDate    DateTime?
  status               String    @default("SCHEDULED") // SCHEDULED, IN_PROGRESS, COMPLETED, OVERDUE
  checklistJson        String?   @db.Text // JSON array of tasks: [{"task": "Inspect filters", "done": false}]
  
  assignedTechnicianId String?
  assignedTechnician   User?     @relation(fields: [assignedTechnicianId], references: [id])

  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model Approval {
  id          String    @id @default(uuid())
  requestNo   String    @unique // e.g. APR-1001
  title       String    // e.g. "Additional Budget for HVAC Chiller Compressor"
  description String?   @db.Text
  amount      Float?
  status      String    @default("PENDING") // PENDING, APPROVED, REJECTED
  
  ticketId    String?
  ticket      Ticket?   @relation(fields: [ticketId], references: [id])
  
  requesterId String
  requester   User      @relation("RequestedApprovals", fields: [requesterId], references: [id])
  
  approverId  String?
  approver    User?     @relation("AssignedApprovals", fields: [approverId], references: [id])
  
  reason      String?   @db.Text // Approval remarks or rejection reason
  decidedAt   DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model KnowledgeArticle {
  id           String   @id @default(uuid())
  title        String
  slug         String   @unique
  category     String   // IT_SUPPORT, MAINTENANCE, FRONT_OFFICE, HOUSEKEEPING, GENERAL
  summary      String   @db.Text
  content      String   @db.Text // Markdown / rich text content
  viewsCount   Int      @default(0)
  helpfulCount Int      @default(0)
  isPublished  Boolean  @default(true)
  
  authorId     String?
  author       User?    @relation(fields: [authorId], references: [id])

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String   // e.g. "TICKET_CREATED", "TICKET_ASSIGNED", "STATUS_CHANGED", "APPROVAL_GRANTED", "LOGIN"
  entityType String   // "TICKET", "ASSET", "INVENTORY", "MAINTENANCE", "USER", "AUTH"
  entityId   String?
  details    String   @db.Text // descriptive log
  ipAddress  String?  @default("127.0.0.1")
  createdAt  DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("TICKET") // TICKET, SLA, APPROVAL, SYSTEM
  isRead    Boolean  @default(false)
  linkUrl   String?
  createdAt DateTime @default(now())
}
